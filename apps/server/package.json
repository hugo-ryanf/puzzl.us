{
  "name": "@puzzle/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.19",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/ws-transport": "^0.18.4",
    "@puzzle/shared": "workspace:*",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@colyseus/tools": "^0.18.10",
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}

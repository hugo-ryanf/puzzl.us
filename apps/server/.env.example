# Copie para apps/server/.env (ignorado pelo git) e preencha.

# Connection string do Neon (Dashboard → Connect). Precisa terminar com ?sslmode=require.
# Sem ela o servidor sobe normalmente, mas sem ranking.
DATABASE_URL=

# LiveKit Cloud (Settings → API Keys). Sem as três, o servidor sobe sem chamada de áudio.
# A URL é a do projeto, no formato wss://<projeto>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Porta do servidor (padrão 2567). Em produção a hospedagem define sozinha.
# PORT=2567

# Só em produção, atrás de proxy (Render): lê o IP real do visitante no X-Forwarded-For,
# usado no limite de envio de fotos. Não ligue no seu PC (o cabeçalho seria falsificável).
# TRUST_PROXY=1

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth,
# tipo "Aplicativo da Web"). Sem as duas, o servidor sobe só com convidados (sem o botão de entrar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço público do site: para onde o Google devolve quem fez login. Em dev é o Vite.
# No Google Cloud, cadastre <PUBLIC_URL>/auth/google/callback como "URI de redirecionamento".
# PUBLIC_URL=http://localhost:5173

# E-mails (separados por vírgula) que viram administradores ao entrar (para moderar fotos).
# ADMIN_EMAILS=voce@gmail.com

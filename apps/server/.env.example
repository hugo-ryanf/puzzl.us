# Copie para apps/server/.env (ignorado pelo git) e preencha.

# Connection string do Neon (Dashboard → Connect). Precisa terminar com ?sslmode=require.
# Sem ela o servidor sobe normalmente, mas sem ranking.
DATABASE_URL=

# LiveKit Cloud (Settings → API Keys). Sem as três, o servidor sobe sem chamada de áudio.
# A URL é a do projeto, no formato wss://<projeto>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Porta do servidor (padrão 2567). Em produção a hospedagem define sozinha.
# PORT=2567

# Só em produção, atrás de proxy (Render): lê o IP real do visitante no X-Forwarded-For,
# usado no limite de envio de fotos. Não ligue no seu PC (o cabeçalho seria falsificável).
# TRUST_PROXY=1

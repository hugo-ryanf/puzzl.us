{
  "name": "puzzl.us",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @puzzle/web --filter @puzzle/server dev",
    "dev:local": "pnpm --parallel --filter @puzzle/web --filter @puzzle/server dev:local",
    "dev:demo": "pnpm --parallel --filter @puzzle/web --filter @puzzle/server dev:demo",
    "build": "pnpm -r build",
    "build:deploy": "pnpm --filter @puzzle/web build && pnpm --filter @puzzle/server build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
    "catalog": "tsx scripts/build-catalog.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
